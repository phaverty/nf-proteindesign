/*
========================================================================================
    Google Cloud Batch config profile
========================================================================================
    Runs the pipeline on Google Cloud Batch (process.executor = 'google-batch'),
    against the infrastructure provisioned by the companion local Terraform project
    at ~/git/nextflow-on-gcp-terraform (service account, work-directory bucket,
    enabled APIs), following the setup in
    https://seqera.io/blog/nextflow-with-gbatch/.

    Values below (project, region, bucket, service account) come from that project's
    `terraform output`. Re-run `terraform output` there and update this file if the
    infrastructure is ever re-provisioned under a different project/bucket/account.

    Google Batch always runs processes in a container, so combine this profile with
    one that enables a container engine, e.g.:
        nextflow run . -profile gcp_batch,docker ...
----------------------------------------------------------------------------------------
*/

params {
    // GPU type used for processes that request `accelerator = 1` in conf/base.config
    // (e.g. PROTEINA_COMPLEXA_DESIGN, RFDIFFUSION_V3_RUN, PROTEINMPNN_OPTIMIZE,
    // FOLDSEEK_SEARCH, BOLTZ2_REFOLD). Google Batch needs an explicit accelerator
    // type and a machine family that can attach it - a bare `accelerator = 1` isn't
    // enough on its own.
    //
    // Using L4 (g2-standard-* family) rather than T4 (n1-standard-*): real jobs
    // against this project repeatedly hit CODE_GCE_ZONE_RESOURCE_POOL_EXHAUSTED for
    // nvidia-tesla-t4 across every zone in us-central1 (a, b, c all failed in turn,
    // not just one bad zone) - a known, widely-reported GCP-wide T4 capacity
    // shortage. L4 is newer with materially better on-demand availability and is
    // in the same quota tier (limit 1, unused) on this project. Torch 2.3+cu121
    // already supports L4's Ada Lovelace architecture, so no image change is needed.
    gcp_gpu_type = 'nvidia-l4'
}

workDir = 'gs://nextflow-runs-nextflow-on-gcp/scratch'

process {
    executor      = 'google-batch'

    // Exit code 14 signals a Google Batch task lost to a transient infra issue
    // (e.g. spot preemption); retry those instead of failing the run outright.
    errorStrategy = { task.exitStatus == 14 ? 'retry' : 'terminate' }
    maxRetries    = 5

    // Nextflow's default output-staging move (nxf_fs_move -> `mv -f`) failed a
    // real job with "mv: preserving permissions ... Operation not permitted" /
    // "preserving times ... Operation not permitted", even though the actual file
    // data had already moved. gcsfuse doesn't support chmod/utimes on its mounted
    // files (our --file-mode/--dir-mode above only fix the mount's static default
    // mode, not later chmod calls), and mv's cross-filesystem fallback tries to
    // chmod/utime the destination to match the source. 'copy' uses `cp -fRL`
    // instead (nxf_fs_copy), which has no -p/preserve flag and never attempts
    // that call.
    stageOutMode = 'copy'

    // machineType must be an exact G2 size, not a family wildcard: Nextflow only
    // auto-sizes a machine type via Seqera's Cloud Info service, which isn't
    // GPU-aware, so it can't be trusted to pick a size that actually satisfies a
    // process's cpu/memory request. Each size below is chosen to cover that
    // process's cpus/memory at task.attempt == 1 (G2 single-GPU sizes only come in
    // fixed 4/8/12/16/32 vCPU steps, each with ~4GB RAM per vCPU):
    //   g2-standard-4  =  4 vCPU /  16 GB
    //   g2-standard-8  =  8 vCPU /  32 GB
    //   g2-standard-12 = 12 vCPU /  48 GB
    //   g2-standard-16 = 16 vCPU /  64 GB
    // Note: conf/base.config scales memory/cpus up on each retry (task.attempt),
    // but these machine types are fixed - a retry past attempt 1 that needs more
    // memory than the assigned size provides will still fail. Bump the relevant
    // size below if that happens in practice.
    //
    // containerOptions also needs to be overridden here: conf/base.config sets
    // '--gpus all' on every GPU process, which is correct for plain local Docker
    // but fails outright on Google Batch's COS VMs. Confirmed via two real failed
    // jobs in sequence:
    //   1. '--gpus all' -> exit 125: "invoking the NVIDIA Container Runtime Hook
    //      directly (e.g. specifying the docker --gpus flag) is not supported...
    //      use the NVIDIA Container Runtime (e.g. --runtime=nvidia) instead."
    //   2. '--runtime=nvidia' -> exit 125: "unknown or invalid runtime name: nvidia"
    //      - that message is generic nvidia-container-runtime-hook boilerplate, not
    //      a real hint: COS has no such Docker runtime registered, since it
    //      deliberately skips installing nvidia-container-toolkit (the package that
    //      would normally add it) - see the STARTUP script's own
    //      "Container-Optimized OS does not require NVIDIA Container Toolkit".
    // Google Batch documents that it handles GPU container access on COS
    // automatically (auto-injecting what's needed, e.g. --privileged) once
    // installGpuDrivers + accelerator are set - no docker GPU flag should be passed
    // at all. So none of the overrides below pass --gpus/--runtime/--device.
    //
    // Every override does set --shm-size, though: Docker's default /dev/shm is a
    // fixed 64MB regardless of how much RAM the host actually has, and PyTorch
    // DataLoader workers (used by BoltzGen and friends) pass batches through
    // shared memory - 64MB broke a real job with "Unexpected bus error... this
    // might be caused by insufficient shared memory (shm)" during BOLTZGEN_RUN.
    // Sized to roughly a quarter of each machine type's RAM.
    withLabel:process_high_gpu {
        // cpus=8, memory=64GB @ attempt 1 - g2-standard-16 has 64GB RAM
        accelerator = [request: 1, type: params.gcp_gpu_type]
        machineType = 'g2-standard-16'
        containerOptions = '--shm-size=16g'
    }
    withLabel:process_medium_gpu {
        // cpus=6, memory=36GB @ attempt 1 - g2-standard-12 has 48GB RAM
        accelerator = [request: 1, type: params.gcp_gpu_type]
        machineType = 'g2-standard-12'
        containerOptions = '--shm-size=12g'
    }
    withName:PROTEINA_COMPLEXA_DESIGN {
        // cpus=8 (process_high_gpu label), memory=40GB @ attempt 1 - g2-standard-12 has 48GB RAM
        accelerator = [request: 1, type: params.gcp_gpu_type]
        machineType = 'g2-standard-12'
        containerOptions = '--shm-size=12g'
    }
    withName:RFDIFFUSION_V3_RUN {
        // cpus=8 (process_high_gpu label), memory=40GB @ attempt 1 - g2-standard-12 has 48GB RAM
        accelerator = [request: 1, type: params.gcp_gpu_type]
        machineType = 'g2-standard-12'
        containerOptions = '--shm-size=12g'
    }
    withName:PROTEINMPNN_OPTIMIZE {
        // cpus=4, memory=16GB @ attempt 1 - g2-standard-4 has 16GB RAM
        accelerator = [request: 1, type: params.gcp_gpu_type]
        machineType = 'g2-standard-4'
        containerOptions = '--shm-size=4g'
    }
    withName:FOLDSEEK_SEARCH {
        // cpus=8, memory=32GB @ attempt 1 - g2-standard-8 has 32GB RAM
        accelerator = [request: 1, type: params.gcp_gpu_type]
        machineType = 'g2-standard-8'
        containerOptions = '--shm-size=8g --entrypoint ""'
    }
    withName:BOLTZ2_REFOLD {
        // memory=32GB @ attempt 1 (no cpu override in base.config) - g2-standard-8 has 32GB RAM
        accelerator = [request: 1, type: params.gcp_gpu_type]
        machineType = 'g2-standard-8'
        containerOptions = '--shm-size=8g -e TORCH_FLOAT32_MATMUL_PRECISION=medium'

        // This project's GPUS_ALL_REGIONS quota is 1 (see nextflow-on-gcp-terraform
        // project setup) - only one GPU VM can actually be provisioned at a time.
        // Without this, Nextflow will submit every BOLTZ2_REFOLD task concurrently
        // and all but one will sit QUEUED waiting on a GPU that's already in use by
        // a sibling task, rather than by a genuinely separate job.
        maxForks = 1
    }
}

google {
    project  = 'nextflow-runs'
    location = 'us-central1'

    batch {
        // Use preemptible/spot VMs for cheaper (but interruptible) execution.
        spot = false

        // Restrict to the zones that actually offer the nvidia-l4 accelerator type
        // in this project (confirmed via `gcloud compute accelerator-types list`);
        // us-central1-f does not. Also excluding -f matches what we saw with T4
        // before switching: it repeatedly failed real jobs with
        // CODE_GCE_ZONE_RESOURCE_POOL_EXHAUSTED there. Re-check zone coverage with
        // the same gcloud command if you change gcp_gpu_type again.
        allowedLocations = ['zones/us-central1-a', 'zones/us-central1-b', 'zones/us-central1-c']

        // Run task VMs as the Terraform-created service account instead of the
        // project's default Compute Engine service account, which usually has no
        // IAM roles bound to it. Without this, a VM's Batch agent can boot but
        // can't write logs/metrics or report status back to Batch, and the job
        // hangs for ~18 minutes before failing with "no VM has agent reporting
        // correctly".
        serviceAccountEmail = 'nextflow-on-gcp-sa@nextflow-runs.iam.gserviceaccount.com'

        // Google Batch mounts workDir's bucket into the VM with gcsfuse before the
        // task container starts. gcsfuse's defaults (file_mode 0644, no execute
        // bit, and no cross-UID access) broke real jobs with "Permission denied"
        // executing .command.run and even reading .command.log - gcsfuse was
        // mounted as one uid (root, via Batch's startup script) while the task
        // container runs as a different uid (the boltzgen image's own user), so
        // plain 0644/no-allow_other blocks it entirely. --file-mode/--dir-mode add
        // the execute bit and -o allow_other permits access from any uid, not just
        // the one that mounted it - both needed since this is a single-tenant,
        // ephemeral Batch VM (no multi-tenant exposure risk from wide permissions).
        gcsfuseOptions = ['-o rw', '-implicit-dirs', '-o allow_other', '--file-mode=0777', '--dir-mode=0777']

        // Default Batch boot disk is only 30GB. Each task gets a fresh, ephemeral
        // VM (no cache persists across tasks/runs on Batch even when a *_cache
        // param is set), so every GPU task re-downloads its model weights from
        // scratch onto that boot disk, on top of the OS + pulled container image
        // (~4-5GB). 30GB left too little room and failed a real job downloading
        // BoltzGen's weights ("Not enough free disk space"). 100GB gives headroom
        // for the largest case (Boltz-2's ~6GB of weights/ligand DB) plus the
        // container image and OS, with margin.
        bootDiskSize = 100.GB
    }
}
